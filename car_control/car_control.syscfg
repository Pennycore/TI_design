PWM2.PWM_CHANNEL_0.dutyCycle    = 50;
PWM2.ccp0PinConfig.$name        = "STEPPER_STEP_PIN";

QEI1.$name                      = "QEI_STEPPER";
QEI1.timerStartTimer            = true;
QEI1.peripheral.$assign         = "TIMG8";
QEI1.peripheral.ccp0Pin.$assign = "PA1";
QEI1.peripheral.ccp1Pin.$assign = "PA0";
QEI1.ccp0PinConfig.$name        = "STEPPER_ENCODER_A_PIN";
QEI1.ccp1PinConfig.$name        = "STEPPER_ENCODER_B_PIN";

SYSCTL.forceDefaultClkConfig = true;
